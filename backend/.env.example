# Get these from your Salesforce External Client App / Connected App
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here

# Must match exactly what you set in Salesforce callback URL
SF_REDIRECT_URI=http://localhost:5000/oauth/callback

# Your Salesforce org My Domain URL
SF_LOGIN_URL=https://your-org.develop.my.salesforce.com

# Random string for session security
SESSION_SECRET=any_long_random_string

PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
